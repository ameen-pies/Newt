# ==============================
# Newt Environment Variables
# ==============================

# --- App ---
APP_NAME=newt
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-random-string

# --- OpenRouter LLM ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-90b-vision-instruct

# --- Qdrant Vector DB ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Voicebox TTS ---
VOICEBOX_URL=http://host.docker.internal:17493
VOICEBOX_PROFILE_ID=
VOICEBOX_ENGINE=qwen_custom_voice
VOICEBOX_INSTRUCT=warm, slow, cinematic

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# --- Sandbox ---
SANDBOX_IMAGE=python:3.11-slim
